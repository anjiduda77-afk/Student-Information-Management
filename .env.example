# ------------------------------------------------------------
# 1. Frontend Configuration
# ------------------------------------------------------------
# Local Development:
VITE_API_BASE_URL=http://localhost:8080
VITE_APP_URL=http://localhost:5173
VITE_WS_BASE_URL=/ws

# Production Example:
# VITE_API_BASE_URL=https://your-backend-domain.com
# VITE_APP_URL=https://your-frontend-domain.com

# ------------------------------------------------------------
# 2. Backend & URL Configuration
# ------------------------------------------------------------
PORT=8080
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:5173

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/student_information_system?useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=YOUR_MYSQL_PASSWORD

# ------------------------------------------------------------
# 3. Security & CORS Configuration
# ------------------------------------------------------------
JWT_SECRET=your_production_secret_key_minimum_64_characters_long_for_hs512
JWT_EXPIRATION=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
